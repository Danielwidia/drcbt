{
  "version": 2,
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.png,app.js,style.css,wordParser.js,db.js,*.ico}",
      "maxDuration": 300
    }
  }
}
